+import { describe, expect, it } from "vitest";
+import { normalizeProjectEditor } from "@/components/video-editor/projectPersistence";
+import {
+	DEFAULT_CURSOR_CLICK_BOUNCE,
+	DEFAULT_CURSOR_CLIP_TO_BOUNDS,
+	DEFAULT_CURSOR_MOTION_BLUR,
+	DEFAULT_CURSOR_SIZE,
+	DEFAULT_CURSOR_SMOOTHING,
+} from "@/components/video-editor/types";
+import { migrateProjectDataToAxcutDocument } from "@/lib/ai-edition/document/migrate";
+import { buildSceneDescription } from "@/native/sceneDescription";
+
+describe("CLI cursor project settings", () => {
+	it.each([
+		true,
+		false,
+	])("preserves show=%s and cursor effects through native scene migration", (show) => {
+		const doc = migrateProjectDataToAxcutDocument({
+			version: 2,
+			media: { screenVideoPath: "/recordings/demo.mov" },
+			editor: normalizeProjectEditor({
+				cursorShow: show,
+				cursorSize: 4.5,
+				cursorSmoothing: 0.42,
+				cursorMotionBlur: 0.2,
+				cursorClickBounce: 1.5,
+				cursorClipToBounds: true,
+				cursorTheme: "default",
+			}),
+		});
+		expect(buildSceneDescription(doc).cursor).toEqual({
+			show,
+			size: 4.5,
+			smoothing: 0.42,
+			motionBlur: 0.2,
+			clickBounce: 1.5,
+			clipToBounds: true,
+			theme: "default",
+		});
+	});
+
+	it("retains existing defaults when old projects omit cursor settings", () => {
+		expect(normalizeProjectEditor({})).toMatchObject({
+			cursorShow: true,
+			cursorSize: DEFAULT_CURSOR_SIZE,
+			cursorSmoothing: DEFAULT_CURSOR_SMOOTHING,
+			cursorMotionBlur: DEFAULT_CURSOR_MOTION_BLUR,
+			cursorClickBounce: DEFAULT_CURSOR_CLICK_BOUNCE,
+			cursorClipToBounds: DEFAULT_CURSOR_CLIP_TO_BOUNDS,
+		});
+	});
+
+	it("rejects nonfinite settings and bounds numerical input like the native inspector", () => {
+		expect(
+			normalizeProjectEditor({
+				cursorSize: Number.NaN,
+				cursorSmoothing: -1,
+				cursorMotionBlur: 9,
+				cursorClickBounce: Number.POSITIVE_INFINITY,
+				cursorShow: "false" as never,
+				cursorClipToBounds: "true" as never,
+			}),
+		).toMatchObject({
+			cursorSize: DEFAULT_CURSOR_SIZE,
+			cursorSmoothing: 0,
+			cursorMotionBlur: 1,
+			cursorClickBounce: DEFAULT_CURSOR_CLICK_BOUNCE,
+			cursorShow: true,
+			cursorClipToBounds: DEFAULT_CURSOR_CLIP_TO_BOUNDS,
+		});
+		expect(normalizeProjectEditor({ cursorSize: -1, cursorClickBounce: -1 })).toMatchObject({
+			cursorSize: 0.5,
+			cursorClickBounce: 0,
+		});
+		expect(normalizeProjectEditor({ cursorSize: 20, cursorClickBounce: 20 })).toMatchObject({
+			cursorSize: 10,
+			cursorClickBounce: 5,
+		});
+	});
+});
